# Modo nuvem (deploy serverless): chave da API da Groq.
# Gere em https://console.groq.com/keys
# Sem ela, o app publicado sobe mas não transcreve.
GROQ_API_KEY=

# Modo local (opcional): use só se o app não encontrar os binários sozinho.
# YTDLP_PATH=/Users/voce/.local/bin/yt-dlp
# FFMPEG_PATH=/Users/voce/.local/bin/ffmpeg
# MLX_WHISPER_PATH=/Users/voce/.local/bin/mlx_whisper
